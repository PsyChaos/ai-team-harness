{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.ai-team/hooks/guard-shell.sh"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.ai-team/hooks/audit-tool.sh", "async": true}
        ]
      }
    ]
  }
}
