# Copy to: .ai-team/runtime/runtime.env
# chmod 600 .ai-team/runtime/runtime.env

HARNESS_PROJECT_OWNER="YOUR_GITHUB_USER_OR_ORG"
HARNESS_PROJECT_NUMBER="1"
HARNESS_REPO="owner/repository"

# Legacy metadata only; coordinator-cycle always uses the deterministic broker.
HARNESS_COORDINATOR_PROVIDER="claude"

# Optional explicit models. Empty = provider default/current configured model.
HARNESS_COORDINATOR_MODEL=""
# Bootstrap planning uses this override, then the provider's STRONG/generic model.
# Bootstrap planning currently requires Claude's tool-free mode. Codex/Gemini
# remain available as workers. Empty provider falls back to coordinator provider.
# Use "claude" explicitly when coordinator provider differs; empty model uses CLI default.
HARNESS_PLANNER_PROVIDER=""
HARNESS_PLANNER_MODEL=""
HARNESS_PLANNER_TIMEOUT_SECONDS="300"
# Absolute external store created by `.ai-team/bin/migrate-secrets`.
# It is outside the repository (directory 0700, file 0600). Never commit it.
HARNESS_SECRETS_FILE=""
HARNESS_CODEX_MODEL=""
HARNESS_CLAUDE_MODEL=""
HARNESS_GEMINI_MODEL=""


# Optional model-profile mapping used by Jev/rules routing.
# Empty profile value -> generic provider model -> provider CLI default.
HARNESS_CODEX_MODEL_FAST=""
HARNESS_CODEX_MODEL_BALANCED=""
HARNESS_CODEX_MODEL_STRONG=""

HARNESS_CLAUDE_MODEL_FAST=""
HARNESS_CLAUDE_MODEL_BALANCED=""
HARNESS_CLAUDE_MODEL_STRONG=""

HARNESS_GEMINI_MODEL_FAST=""
HARNESS_GEMINI_MODEL_BALANCED=""
HARNESS_GEMINI_MODEL_STRONG=""

HARNESS_COORDINATOR_MAX_TURNS="80"
HARNESS_WORKER_MAX_TURNS="100"
HARNESS_MAX_IMPLEMENTERS="4"

# Make user-local provider binaries visible to systemd user services.
# Worker execution requires bubblewrap (`bwrap`) for a private mount/PID namespace.
HARNESS_PATH_PREFIX="$HOME/.local/bin:$HOME/.local/share/pnpm:$HOME/.npm-global/bin:$HOME/.nvm/current/bin"

HARNESS_CYCLE_SECONDS="120"

HARNESS_ENABLE_CLAUDE="1"
HARNESS_ENABLE_CODEX="1"
HARNESS_ENABLE_GEMINI="1"

HARNESS_IMPLEMENTER_ORDER="codex,claude,gemini"
HARNESS_REVIEWER_ORDER="claude,codex,gemini"
HARNESS_MAX_RETRIES="2"
# Fail closed when a repository exposes no CI checks. Set to 1 only when the
# repository deliberately has no required CI workflow.
HARNESS_ALLOW_EMPTY_CI="0"

# ---------------- Decision Engine ----------------
# rules | jev
HARNESS_DECISION_ENGINE="rules"

# If Jev fails, is unavailable, or confidence is below threshold:
# rules is used automatically.
HARNESS_DECISION_FALLBACK="rules"

# TypeSafe Jev API key belongs in HARNESS_SECRETS_FILE, never runtime.env.
TYPESAFE_MODEL="jev-latest"
TYPESAFE_BASE_URL="https://api.typesafe.ai"

# Feature switches. Jev is never used for deterministic CI/dependency/merge facts.
HARNESS_JEV_TASK_CLASSIFICATION="1"
HARNESS_JEV_PROVIDER_ROUTING="1"
HARNESS_JEV_MODEL_ROUTING="1"
HARNESS_JEV_REVIEW_ROUTING="1"
HARNESS_JEV_RETRY_ROUTING="1"
HARNESS_JEV_ACTION_ROUTING="1"

# Confidence gates. Below these values, the decision falls back to rules.
HARNESS_JEV_WORK_TYPE_CONFIDENCE="0.70"
HARNESS_JEV_PROVIDER_CONFIDENCE="0.75"
HARNESS_JEV_MODEL_CONFIDENCE="0.75"
HARNESS_JEV_REVIEW_CONFIDENCE="0.80"
HARNESS_JEV_RETRY_CONFIDENCE="0.80"
HARNESS_JEV_ACTION_CONFIDENCE="0.85"

# Provider-specific safety/runtime settings.
HARNESS_GEMINI_APPROVAL_MODE="yolo"
HARNESS_GEMINI_USE_SANDBOX="1"
