#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"
load_runtime

USER_DIR="$HOME/.config/systemd/user"
mkdir -p "$USER_DIR"
SERVICE="$USER_DIR/ai-harness-coordinator.service"
TIMER="$USER_DIR/ai-harness-coordinator.timer"
SECONDS="${HARNESS_CYCLE_SECONDS:-120}"

cat > "$SERVICE" <<EOF
[Unit]
Description=AI Team Harness Coordinator Cycle
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=$HARNESS_ROOT
ExecStart=$HARNESS_ROOT/.ai-team/bin/coordinator-cycle
TimeoutStartSec=0
EOF

cat > "$TIMER" <<EOF
[Unit]
Description=AI Team Harness Continuous Coordinator

[Timer]
OnBootSec=30
OnUnitInactiveSec=${SECONDS}s
AccuracySec=5s
Persistent=true
Unit=ai-harness-coordinator.service

[Install]
WantedBy=timers.target
EOF

systemctl --user daemon-reload

echo "Installed:"
echo "  $SERVICE"
echo "  $TIMER"
echo
echo "Enable with:"
echo "  systemctl --user enable --now ai-harness-coordinator.timer"
