#!/usr/bin/env bash
set -euo pipefail
umask 077

want_bootstrap=0
case "${1:-}" in
  "") ;;
  --bootstrap) want_bootstrap=1 ;;
  *) echo "Usage: $0 [--bootstrap]" >&2; exit 2 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

ROOT="$(harness_root)"
RUNTIME="$ROOT/.ai-team/runtime/runtime.env"
[[ -f "$RUNTIME" && ! -L "$RUNTIME" ]] || {
  echo "Missing regular runtime configuration: $RUNTIME" >&2
  exit 2
}

# Read the legacy file only inside this privileged migration process.
# shellcheck disable=SC1090
source "$RUNTIME"
SECRET_FILE="${HARNESS_SECRETS_FILE:-$(harness_default_secrets_file)}"
[[ "$SECRET_FILE" = /* ]] || {
  echo "HARNESS_SECRETS_FILE must be an absolute path" >&2
  exit 2
}
SECRET_DIR="$(dirname "$SECRET_FILE")"
mkdir -p "$SECRET_DIR"
chmod 700 "$SECRET_DIR"
[[ ! -L "$SECRET_DIR" && ! -L "$SECRET_FILE" ]] || {
  echo "Refusing symlinked secret-store path" >&2
  exit 2
}

declare -A secrets=()
store_preexisted=0
if [[ -f "$SECRET_FILE" ]]; then
  store_preexisted=1
  [[ "$(stat -c '%u' "$SECRET_FILE")" == "$(id -u)" ]] || {
    echo "Secret store is not owned by the current user" >&2
    exit 2
  }
  while IFS='=' read -r secret_name secret_value; do
    [[ -z "$secret_name" ]] && continue
    case "$secret_name" in
      HARNESS_BOOTSTRAP_HMAC_KEY|HARNESS_BROKER_HMAC_KEY|TYPESAFE_API_KEY) ;;
      *) echo "Secret store contains an unsupported key" >&2; exit 2 ;;
    esac
    [[ "$secret_value" =~ ^[A-Za-z0-9_./:+@=-]*$ ]] || {
      echo "Secret store contains an unsafe value encoding" >&2; exit 2;
    }
    printf -v "$secret_name" '%s' "$secret_value"
  done < "$SECRET_FILE"
fi
for name in HARNESS_BOOTSTRAP_HMAC_KEY HARNESS_BROKER_HMAC_KEY TYPESAFE_API_KEY; do
  secrets["$name"]="${!name:-}"
done
if [[ -z "${secrets[HARNESS_BOOTSTRAP_HMAC_KEY]}" && "$want_bootstrap" -eq 1 ]]; then
  if [[ "${HARNESS_BOOTSTRAP_KEY_STATE:-never-created}" == "active" ]]; then
    echo "Bootstrap signing key was previously active; restore it from backup instead of rotating" >&2
    exit 2
  fi
  secrets[HARNESS_BOOTSTRAP_HMAC_KEY]="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
fi
[[ -n "${secrets[HARNESS_BROKER_HMAC_KEY]}" ]] || \
  secrets[HARNESS_BROKER_HMAC_KEY]="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"

secret_tmp="$(mktemp "$SECRET_DIR/.secrets.XXXXXX")"
runtime_tmp="$(mktemp "$ROOT/.ai-team/runtime/.runtime.XXXXXX")"
trap 'rm -f -- "$secret_tmp" "$runtime_tmp"' EXIT
for name in HARNESS_BOOTSTRAP_HMAC_KEY HARNESS_BROKER_HMAC_KEY TYPESAFE_API_KEY; do
  if [[ -n "${secrets[$name]}" ]]; then
    [[ "${secrets[$name]}" =~ ^[A-Za-z0-9_./:+@=-]*$ ]] || {
      echo "Secret value for $name contains unsupported characters" >&2; exit 2;
    }
    printf '%s=%s\n' "$name" "${secrets[$name]}" >> "$secret_tmp"
  fi
done
chmod 600 "$secret_tmp"
mv -f "$secret_tmp" "$SECRET_FILE"

grep -Ev '^(export[[:space:]]+)?(HARNESS_BOOTSTRAP_HMAC_KEY|HARNESS_BROKER_HMAC_KEY|TYPESAFE_API_KEY|GH_TOKEN|GITHUB_TOKEN)=' \
  "$RUNTIME" > "$runtime_tmp" || true
grep -Ev '^(export[[:space:]]+)?HARNESS_SECRETS_FILE=' "$runtime_tmp" > "${runtime_tmp}.filtered"
mv "${runtime_tmp}.filtered" "$runtime_tmp"
printf 'HARNESS_SECRETS_FILE=%q\n' "$SECRET_FILE" >> "$runtime_tmp"
grep -Ev '^(export[[:space:]]+)?HARNESS_BOOTSTRAP_KEY_STATE=' "$runtime_tmp" > "${runtime_tmp}.filtered"
mv "${runtime_tmp}.filtered" "$runtime_tmp"
if [[ -n "${secrets[HARNESS_BOOTSTRAP_HMAC_KEY]}" ]]; then
  printf 'HARNESS_BOOTSTRAP_KEY_STATE=active\n' >> "$runtime_tmp"
else
  printf 'HARNESS_BOOTSTRAP_KEY_STATE=never-created\n' >> "$runtime_tmp"
fi
chmod 600 "$runtime_tmp"
mv -f "$runtime_tmp" "$RUNTIME"
printf 'Secret store ready: %s\n' "$SECRET_FILE"
