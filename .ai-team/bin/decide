#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"
load_runtime
if [[ "${HARNESS_DECISION_ENGINE:-rules}" == "jev" ]]; then
  load_secrets
fi

exec python3 "$HARNESS_ROOT/.ai-team/decision/decision_engine.py" "$@"
