#!/usr/bin/env bash
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT" ]]; then
  echo "FAIL: run inside a Git repository"
  exit 1
fi

LIVE=0
[[ "${1:-}" == "--live" ]] && LIVE=1

fail=0

check_cmd() {
  local cmd="$1"
  if command -v "$cmd" >/dev/null 2>&1; then
    echo "OK:   $cmd -> $(command -v "$cmd")"
  else
    echo "FAIL: $cmd not found"
    fail=1
  fi
}

check_cmd git
check_cmd gh
check_cmd jq
check_cmd python3
check_cmd systemctl
check_cmd systemd-run
check_cmd bwrap

echo
if gh auth status >/dev/null 2>&1; then
  echo "OK:   GitHub authentication"
else
  echo "FAIL: GitHub authentication (run: gh auth login)"
  fail=1
fi

if gh project list --owner "@me" --limit 1 >/dev/null 2>&1; then
  echo "OK:   GitHub Projects access"
else
  echo "WARN: GitHub Projects access failed. Run: gh auth refresh -s project"
fi

echo
providers=0
for p in claude codex gemini; do
  if command -v "$p" >/dev/null 2>&1; then
    echo "OK:   provider $p -> $(command -v "$p")"
    providers=$((providers+1))
  else
    echo "INFO: provider $p not installed"
  fi
done

if [[ "$providers" -eq 0 ]]; then
  echo "FAIL: no supported provider CLI found"
  fail=1
fi

echo
ENV="$ROOT/.ai-team/runtime/runtime.env"
if [[ -f "$ENV" ]]; then
  echo "OK:   runtime.env exists"
  if grep -Eq '^(export[[:space:]]+)?(HARNESS_BOOTSTRAP_HMAC_KEY|HARNESS_BROKER_HMAC_KEY|TYPESAFE_API_KEY|GH_TOKEN|GITHUB_TOKEN)=' "$ENV"; then
    echo "FAIL: runtime.env contains secret material (run: .ai-team/bin/migrate-secrets)"
    fail=1
  fi
  # shellcheck disable=SC1090
  source "$ENV"

  if [[ "${HARNESS_PROJECT_OWNER:-}" == "YOUR_GITHUB_USER_OR_ORG" || -z "${HARNESS_PROJECT_OWNER:-}" ]]; then
    echo "FAIL: HARNESS_PROJECT_OWNER still has template/empty value"
    fail=1
  fi
  if [[ "${HARNESS_REPO:-}" == "owner/repository" || -z "${HARNESS_REPO:-}" ]]; then
    echo "FAIL: HARNESS_REPO still has template/empty value"
    fail=1
  fi

  engine="${HARNESS_DECISION_ENGINE:-rules}"
  if [[ "$engine" == "jev" ]]; then
    # shellcheck disable=SC1090
    source "$ROOT/.ai-team/bin/lib.sh"
    if load_secrets >/dev/null 2>&1 && [[ -n "${TYPESAFE_API_KEY:-}" ]]; then
      echo "OK:   Jev enabled and TYPESAFE_API_KEY is configured"
      if [[ "$LIVE" -eq 1 ]]; then
        if "$ROOT/.ai-team/bin/decide" smoke-test >/dev/null; then
          echo "OK:   Jev live smoke test"
        else
          echo "FAIL: Jev live smoke test"
          fail=1
        fi
      else
        echo "INFO: run '.ai-team/bin/harness-doctor --live' for a live Jev API test"
      fi
    else
      echo "FAIL: Jev enabled but TYPESAFE_API_KEY is empty"
      fail=1
    fi
  else
    echo "OK:   decision engine = rules (Jev optional/off)"
  fi
  # Verify the external store even when Jev is disabled: bootstrap and broker
  # signing keys are mandatory for autonomous operation.
  # shellcheck disable=SC1090
  source "$ROOT/.ai-team/bin/lib.sh"
  if load_secrets >/dev/null 2>&1 \
      && [[ "${HARNESS_BOOTSTRAP_HMAC_KEY:-}" =~ ^[a-f0-9]{64}$ ]] \
      && [[ "${HARNESS_BROKER_HMAC_KEY:-}" =~ ^[a-f0-9]{64}$ ]]; then
    echo "OK:   external secret store permissions and signing keys"
  else
    echo "FAIL: external secret store invalid (run: .ai-team/bin/migrate-secrets)"
    fail=1
  fi
else
  echo "FAIL: runtime.env missing"
  echo "      cp .ai-team/config/runtime.env.example .ai-team/runtime/runtime.env"
  fail=1
fi

echo
for skill in coordinating-projects planning-projects implementing-tasks reviewing-changes security-reviewing merging-work recovering-work; do
  if [[ -f "$ROOT/.agents/skills/$skill/SKILL.md" ]]; then
    echo "OK:   skill $skill"
  else
    echo "FAIL: missing skill $skill"
    fail=1
  fi
done

echo
if [[ "$fail" -eq 0 ]]; then
  echo "Harness doctor: PASS"
  exit 0
else
  echo "Harness doctor: FAIL"
  exit 1
fi
