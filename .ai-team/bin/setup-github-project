#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"
load_runtime
require_var HARNESS_PROJECT_OWNER
require_var HARNESS_PROJECT_NUMBER

OWNER="$HARNESS_PROJECT_OWNER"
PROJECT="$HARNESS_PROJECT_NUMBER"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

gh project field-list "$PROJECT" --owner "$OWNER" --format json --jq '.fields[].name' > "$TMP"

has_field() { grep -Fxq "$1" "$TMP"; }
record_field() { echo "$1" >> "$TMP"; }

create_single() {
  local name="$1" options="$2"
  if has_field "$name"; then echo "exists: $name"; return; fi
  echo "create: $name"
  gh project field-create "$PROJECT" --owner "$OWNER" --name "$name" \
    --data-type SINGLE_SELECT --single-select-options "$options" >/dev/null
  record_field "$name"
}

create_text() {
  local name="$1"
  if has_field "$name"; then echo "exists: $name"; return; fi
  echo "create: $name"
  gh project field-create "$PROJECT" --owner "$OWNER" --name "$name" --data-type TEXT >/dev/null
  record_field "$name"
}

create_number() {
  local name="$1"
  if has_field "$name"; then echo "exists: $name"; return; fi
  echo "create: $name"
  gh project field-create "$PROJECT" --owner "$OWNER" --name "$name" --data-type NUMBER >/dev/null
  record_field "$name"
}

create_single "Harness Status" "BACKLOG,PLANNING,READY,CLAIMED,IN_PROGRESS,IMPLEMENTED,REVIEWING,CHANGES_REQUESTED,VERIFIED,MERGE_READY,MERGING,DONE,BLOCKED,RETRY_PENDING,WAITING_HUMAN,WAITING_PROVIDER,FAILED"
create_single "Priority" "P0,P1,P2,P3"
create_single "Risk" "LOW,MEDIUM,HIGH,CRITICAL"
create_single "Work Type" "Architecture,Backend,Frontend,Mobile,Database,DevOps,Test,Security,Documentation,Refactor,Bug"
create_single "Provider" "Claude,OpenAI,Gemini,Local,Other"
create_single "Agent Role" "Planner,Implementer,Reviewer,Security Reviewer,Merge Manager"
create_text "Model"
create_number "Retry Count"
create_text "Evidence"

echo "GitHub Project fields are ready."
